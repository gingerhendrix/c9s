{
  "name": "@tooee/c9s",
  "version": "0.1.0",
  "description": "A k9s-style terminal UI for Cloudflare, built with Tooee on the cf CLI",
  "keywords": [
    "cloudflare",
    "cf",
    "k9s",
    "opentui",
    "terminal",
    "tooee",
    "tui"
  ],
  "license": "MIT",
  "author": "Gareth Andrew",
  "type": "module",
  "bin": {
    "c9s": "./bin/c9s"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/cli.tsx",
    "demo": "bun src/cli.tsx --demo",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "oxlint src test",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "@tooee/choose": "^0.10.2",
    "@tooee/clipboard": "^0.10.2",
    "@tooee/commands": "^0.10.2",
    "@tooee/config": "^0.10.2",
    "@tooee/layout": "^0.10.2",
    "@tooee/overlays": "^0.10.2",
    "@tooee/renderers": "^0.10.2",
    "@tooee/router": "^0.10.2",
    "@tooee/search": "^0.10.2",
    "@tooee/shell": "^0.10.2",
    "@tooee/themes": "^0.10.2",
    "@tooee/toasts": "^0.10.2",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
